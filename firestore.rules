rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }
    function isResp() {
      return isAuth() &&
        get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data.ruolo == "responsabile";
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    // Lettura globale per tutti gli utenti autenticati
    match /{document=**} {
      allow read: if isAuth();
    }
    // Inventario:
    // - Creare/cancellare articoli: solo responsabili
    // - Aggiornare: tutti gli autenticati MA solo il campo qty
    //   (così gli operai possono registrare prelievi ma non
    //    toccare nome, codice, prezzo, categoria)
    match /inventario/{doc} {
      allow create, delete: if isResp();
      allow update: if isResp()
        || (isAuth() &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['qty']));
    }
    // Movimenti:
    // - Creare: tutti gli autenticati (operai registrano prelievi)
    // - Modificare/cancellare: solo l'autore del movimento o i responsabili
    match /movimenti/{doc} {
      allow create: if isAuth();
      allow update, delete: if isResp()
        || isOwner(resource.data.operatorUid);
    }
    // Categorie: solo responsabili
    match /categorie/{doc} {
      allow write: if isResp();
    }
    // Cantieri: lettura tutti, scrittura solo responsabili
    match /cantieri/{doc} {
      allow read: if isAuth();
      allow write: if isResp();
    }
    // Fornitori: lettura tutti, scrittura solo responsabili
    match /fornitori/{doc} {
      allow read: if isAuth();
      allow write: if isResp();
    }
    // Prodotti volatili (bobine a rimborso): lettura tutti, scrittura solo responsabili
    match /volatili/{doc} {
      allow read: if isAuth();
      allow write: if isResp();
    }
    // Mezzi aziendali: lettura tutti, scrittura solo responsabili
    match /mezzi/{doc} {
      allow read: if isAuth();
      allow write: if isResp();
    }
    // Operatori: lettura tutti, scrittura solo responsabili
    match /operatori/{doc} {
      allow read: if isAuth();
      allow write: if isResp();
    }
    // Meta: flag interni per migrazioni one-shot (es. riparaQta_v1)
    match /meta/{doc} {
      allow read: if isAuth();
      allow write: if isResp();
    }
    // Presenze: lettura tutti gli autenticati, scrittura tutti
    // (dipendenti scrivono solo le proprie, controllo lato app)
    match /presenze/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
    // Utenti: ognuno legge solo il proprio, scrittura mai dal client
    match /utenti/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
